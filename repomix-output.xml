'use client';

import { useState } from 'react';
import { useRouter } from 'next/navigation';
import { deleteProjectAction } from '@/app/actions/project';

export default function DeleteProjectButton({ projectId, projectName }: { projectId: string, projectName: string }) {
  const router = useRouter();
  const [isDeleting, setIsDeleting] = useState(false);
  
  // ✨ 新增：局部确认状态
  const [showConfirm, setShowConfirm] = useState(false);

  // 展开二次确认
  const handleInitialClick = (e: React.MouseEvent) => {
    e.preventDefault();
    e.stopPropagation();
    setShowConfirm(true);
  };

  // 取消删除
  const handleCancel = (e: React.MouseEvent) => {
    e.preventDefault();
    e.stopPropagation();
    setShowConfirm(false);
  };

  // 真正执行删除
  const handleConfirmDelete = async (e: React.MouseEvent) => {
    e.preventDefault();
    e.stopPropagation();

    setIsDeleting(true);
    try {
      const res = await deleteProjectAction(projectId);
      if (res.success) {
        router.refresh();
      } else {
        alert(res.error || "销毁失败");
        setIsDeleting(false);
        setShowConfirm(false);
      }
    } catch (err) {
      alert("网络异常，无法销毁项目。");
      setIsDeleting(false);
      setShowConfirm(false);
    }
  };

  if (showConfirm) {
    return (
      <div 
        onClick={(e) => { e.preventDefault(); e.stopPropagation(); }} 
        className="flex items-center gap-1.5 bg-academia-bg border border-academia-crimson/50 rounded-lg p-1 animate-fade-in shadow-lg"
      >
        <span className="text-[10px] text-academia-crimson font-bold px-1">彻底抹除？</span>
        
        <button
          onClick={handleConfirmDelete}
          disabled={isDeleting}
          className="text-[10px] bg-academia-crimson text-white px-2 py-0.5 rounded hover:bg-red-700 transition-colors font-bold"
        >
          {isDeleting ? '...' : '确认'}
        </button>
        
        <button
          onClick={handleCancel}
          disabled={isDeleting}
          className="text-[10px] bg-academia-surface text-academia-muted hover:text-academia-parchment px-2 py-0.5 rounded border border-academia-border transition-colors"
        >
          取消
        </button>
      </div>
    );
  }

  // ----------------------------------------------------
  // 2. 默认状态：暗色调的小图标
  // ----------------------------------------------------
  return (
    <button 
      onClick={handleInitialClick}
      className="text-xs text-academia-muted hover:text-academia-crimson transition-colors p-1.5 rounded-md border border-transparent hover:border-academia-crimson/30 hover:bg-academia-crimson/10"
