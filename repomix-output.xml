<file path="app/globals.css">
/* 1. Tailwind v4 的全新引入方式 */
@import "tailwindcss";

/* 2. v4 专属的主题配置块 */
@theme {
  /* 定义暗黑学院专属调色板 */
  --color-academia-bg: #161614;
  --color-academia-surface: #232321;
  --color-academia-border: #3a3935;
  --color-academia-parchment: #e8e4d9;
  --color-academia-gold: #c19c5c;
  --color-academia-crimson: #722f2f;
  --color-academia-muted: #8c8b88;

  /* 定义动画 */
  --animate-breathe: breathe 3s ease-in-out infinite;
  --animate-fade-in-up: fade-in-up 0.7s ease-out forwards;
  
  /* 定义关键帧 */
  @keyframes breathe {
    0%, 100% { opacity: 0.5; transform: scale(0.99); }
    50% { opacity: 1; transform: scale(1); }
  }
  @keyframes fade-in-up {
    0% { opacity: 0; transform: translateY(12px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }
}

/* 3. 全局基础样式覆盖 (使用原生 CSS 变量替代 @apply) */
@layer base {
  body {
    background-color: var(--color-academia-bg);
    color: var(--color-academia-parchment);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* 优雅的深色滚动条 */
  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background-color: var(--color-academia-bg);
  }
  ::-webkit-scrollbar-thumb {
    background-color: var(--color-academia-border);
    border-radius: 9999px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background-color: var(--color-academia-muted);
  }
}

/* 4. 骨架屏光泽扫过特效 */
@layer utilities {
  .animate-shimmer-bg {
    position: relative;
    overflow: hidden;
    background-color: var(--color-academia-surface);
  }
  .animate-shimmer-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
    background-image: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0,
      rgba(232, 228, 217, 0.04) 20%,
      rgba(232, 228, 217, 0.08) 60%,
      rgba(255, 255, 255, 0)
    );
    animation: shimmer 2s infinite;
  }
}
